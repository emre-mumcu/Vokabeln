@* Bu klasör Views/_ViewImports.cshtml kapsamı dışında; asp-append-version için tag helper'lar burada eklenir *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL"
            crossorigin="anonymous"></script>

            @* asp-append-version: dosya değişince adres de değişir (app.js?v=...), tarayıcı eski sürümü önbellekten kullanmaz *@
            <script type="text/javascript" src="~/js/app.js" asp-append-version="true"></script>
