@using Vokabeln.AppData.Entities
@using Vokabeln.AppData.Enums
@using Vokabeln.AppLib.Extensions
@using Vokabeln.ViewModels
@model ConjugationFormViewModel

@{
    // İptal: kelimenin detay sayfası
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl)
        ? returnUrl
        : Url.Action("Details", "Words", new { id = Model.WordId })!;

    // Zamana göre kısa yazım ipucu
    var hint = Model.Tense switch
    {
        Tense.Perfekt => $"Yardımcı fiille birlikte yazın, ör. \"{(Model.Auxiliary == AuxiliaryVerb.Sein ? "bin gegangen" : "habe gemacht")}\".",
        Tense.FuturI => "\"werden\" ile birlikte yazın, ör. \"werde gehen\".",
        Tense.KonjunktivII => "ör. \"ginge\" ya da \"würde gehen\"; ikisi de doğruysa / ile ayırın.",
        _ => "Yalnızca fiilin çekimli halini yazın, ör. \"gehe\"."
    };
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <h4 class="mb-0">@Model.Tense.GetDescription() · <span class="fw-bold">@Model.Word</span></h4>

            @* Bu zamanın 6 formunu yerel Wiktionary kaynağından (wiktionary-de.json) doldurur *@
            <button type="button" id="wiktionaryButton" class="btn-outline theme-secondary text-nowrap"
                    data-wiktionary-url="@Url.Action("Lookup", "Wiktionary")"
                    data-word="@Model.Word" data-tense="@Model.Tense" data-type="@((int)WordType.Verb)">
                <i class="bi bi-cloud-download"></i> Wiktionary'den getir
            </button>
        </div>

        <div class="card-body">

            <p class="fg-secondary">
                @hint
                Zamir yazmayın. Bir kişi için birden fazla doğru form varsa <code>/</code> ile ayırın (ör. <code>fragte / frug</code>).
                Tüm alanları boşaltıp kaydederseniz bu zamanın çekimi silinir.
            </p>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="WordId" />
                <input type="hidden" asp-for="Tense" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                @for (var i = 0; i < ConjugationBase.PersonLabels.Length; i++)
                {
                    <div class="mb-3 row">
                        <label for="form@(i)" class="sm:col-2 col-form-label fw-bold">@ConjugationBase.PersonLabels[i]</label>
                        <div class="sm:col-10">
                            <input id="form@(i)" name="Forms[@i]" value="@Model.Forms.ElementAtOrDefault(i)" class="form-control"
                                   autocomplete="off" spellcheck="false" @(i == 0 ? "autofocus" : "") />
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <a href="@backUrl" class="btn-outline theme-secondary">İptal</a>
                    <button type="submit" class="btn-solid theme-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
                </div>
            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const button = document.getElementById("wiktionaryButton");
            const inputs = Array.from({ length: @ConjugationBase.PersonLabels.Length }, function (_, i) { return document.getElementById("form" + i); });

            button.addEventListener("click", async function () {
                const entry = await Wiktionary.find(button, button.dataset.word, button.dataset.type);
                if (!entry) return;

                const forms = entry.conjugations[button.dataset.tense];
                if (!forms || forms.every(function (f) { return !f; })) {
                    Swal.fire({ icon: "info", text: "Wiktionary kaynağında \"" + entry.word + "\" için bu zamanın çekimi yok." });
                    return;
                }

                const labels = @Json.Serialize(ConjugationBase.PersonLabels);
                const conflicts = inputs
                    .map(function (input, i) { return forms[i] && input.value.trim() !== "" && input.value.trim() !== forms[i] ? labels[i] : null; })
                    .filter(function (x) { return x; });

                const mode = await Wiktionary.askOverwrite(conflicts);
                if (!mode) return;

                const filled = [];
                inputs.forEach(function (input, i) {
                    if (!forms[i] || input.value.trim() === forms[i]) return;
                    if (mode === "empty" && input.value.trim() !== "") return;
                    input.value = forms[i];
                    filled.push(labels[i]);
                });

                Wiktionary.summary(entry, filled, false);
            });
        })();
    </script>
}
