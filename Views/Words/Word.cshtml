@using Vokabeln.AppData.Enums
@model Vokabeln.AppData.Entities.WordEntity

@{
    // İptal: gelinen sayfaya (liste, arama sonucu, detay); yoksa kelime listesi
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Index")!;
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">@(Model.Id > 0 ? "Edit Word" : "Add New Word")</h4>
        </div>

        <div class="card-body">

            <form asp-action="Word" method="post">

                <div asp-validation-summary="ModelOnly" class="fg-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3 row">
                    <label asp-for="Word" class="sm:col-2 col-form-label"></label>
                    <div class="sm:col-10">
                        <div class="d-flex gap-2">
                            <input asp-for="Word" class="form-control" />
                            @* Yerel Wiktionary kaynağından (wiktionary-de.json) alanları doldurur; çekimli hal de aranabilir (ging -> gehen) *@
                            <button type="button" id="wiktionaryButton" class="btn-outline theme-secondary text-nowrap"
                                    data-wiktionary-url="@Url.Action("Lookup", "Wiktionary")"
                                    title="Artikel, tür, çoğul, anlam, örnek ve fiil bilgilerini Wiktionary kaynağından getirir">
                                <i class="bi bi-cloud-download"></i> Wiktionary'den getir
                            </button>
                        </div>
                        <span asp-validation-for="Word" class="fg-danger"></span>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="WordType" class="sm:col-2 col-form-label"></label>
                    <div class="sm:col-10">
                        <select asp-for="WordType" class="form-control" asp-items="Html.GetEnumSelectList<WordType>()">
                            <option value="">-- Seçiniz --</option>
                        </select>
                        <span asp-validation-for="WordType" class="fg-danger"></span>
                    </div>
                </div>

                @* Fiil bilgileri: yalnızca tür "Verb" seçiliyken görünür *@
                <div id="verbBox" @(Model.WordType == WordType.Verb ? "" : "hidden")>
                    <div class="mb-3 row">
                        <label asp-for="Auxiliary" class="sm:col-2 col-form-label">Hilfsverb</label>
                        <div class="sm:col-10">
                            <select asp-for="Auxiliary" class="form-control" asp-items="Html.GetEnumSelectList<AuxiliaryVerb>()">
                                <option value="">-- Seçiniz --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="PartizipII" class="sm:col-2 col-form-label">Partizip II</label>
                        <div class="sm:col-10">
                            <input asp-for="PartizipII" class="form-control" placeholder="ör. gegangen" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="sm:col-10 sm:offset-2">
                            <div class="form-check">
                                <input asp-for="IsSeparable" class="form-check-input" />
                                <label asp-for="IsSeparable" class="form-check-label">Ayrılabilir fiil (trennbar, ör. anfangen)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3 row d-none" id="pluralRow">
                    <label asp-for="Plural" class="sm:col-2 col-form-label"></label>
                    <div class="sm:col-10">
                        <input asp-for="Plural" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Meaning" class="sm:col-2 col-form-label"> </label>
                    <div class="sm:col-10">
                        <textarea asp-for="Meaning" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Sample" class="sm:col-2 col-form-label"></label>
                    <div class="sm:col-10">
                        <textarea asp-for="Sample" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@backUrl" class="btn-outline theme-secondary">İptal</a>
                    <button type="submit" class="btn-solid theme-primary">Save</button>
                </div>
    
            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const wordInput = document.getElementById("Word");
            const typeSelect = document.getElementById("WordType");
            const pluralInput = document.getElementById("Plural");
            
            const pluralRow = document.getElementById("pluralRow");

            // Enum'daki "Noun" seçeneğinin value'sunu metninden bul
            const nounOption = Array.from(typeSelect.options).find(o => o.text.trim().toLowerCase() === "noun");

            function updateByArticle() 
            {
                const startsWithArticle = /^\s*(der|die|das)\s/i.test(wordInput.value);

                if (startsWithArticle) {
                    if (nounOption) typeSelect.value = nounOption.value;
                    pluralRow.classList.remove("d-none");
                } else {
                     if (nounOption && typeSelect.value === nounOption.value) typeSelect.value = "";
                    pluralRow.classList.add("d-none");
                    pluralInput.value = "";         // gizlenen alanda eski değer kalmasın
                }

                updateVerbBox(); // tür kodla değiştirildiğinde change olayı tetiklenmez
            }

            // Fiil alanları yalnızca tür "Verb" iken görünür (kayıtta diğer türler için temizlenir)
            const verbBox = document.getElementById("verbBox");
            const verbValue = "@((int)WordType.Verb)";

            function updateVerbBox() {
                verbBox.hidden = typeSelect.value !== verbValue;
            }

            typeSelect.addEventListener("change", updateVerbBox);
            wordInput.addEventListener("input", updateByArticle);
            updateByArticle(); // sayfa açılışında (güncelleme modunda) da çalışsın

            // Wiktionary'den getir: seçilen maddeyle formu doldurur.
            // Dolu bir alan farklı değerle değişecekse önce sorulur (üzerine yaz / yalnızca boş alanlar).
            const wiktionaryButton = document.getElementById("wiktionaryButton");
            const meaningInput = document.getElementById("Meaning");
            const sampleInput = document.getElementById("Sample");
            const auxiliarySelect = document.getElementById("Auxiliary");
            const partizipInput = document.getElementById("PartizipII");
            const separableInput = document.getElementById("IsSeparable");

            wiktionaryButton.addEventListener("click", async function () {
                const entry = await Wiktionary.find(wiktionaryButton, wordInput.value, typeSelect.value);
                if (!entry) return;

                const isVerb = entry.wordType === @((int)WordType.Verb);
                const value = function (v) { return v === null || v === undefined ? "" : String(v); };

                // [alan adı, input, yeni değer] — Kelime her zaman bulunan maddeyle değişir (ging -> gehen)
                const fields = [
                    ["Tür", typeSelect, value(entry.wordType)],
                    ["Çoğul", pluralInput, value(entry.plural)],
                    ["Anlam", meaningInput, value(entry.meaning)],
                    ["Örnek", sampleInput, value(entry.sample)]
                ];
                if (isVerb) {
                    fields.push(["Hilfsverb", auxiliarySelect, value(entry.auxiliary)]);
                    fields.push(["Partizip II", partizipInput, value(entry.partizipII)]);
                }

                const conflicts = fields
                    .filter(function (f) { return f[2] !== "" && f[1].value.trim() !== "" && f[1].value.trim() !== f[2]; })
                    .map(function (f) { return f[0]; });

                const mode = await Wiktionary.askOverwrite(conflicts);
                if (!mode) return;

                const filled = [];

                if (wordInput.value.trim() !== entry.word) {
                    wordInput.value = entry.word;
                    filled.push("Kelime");
                }
                updateByArticle(); // artikele göre tür ve çoğul satırı ayarlanır

                fields.forEach(function (f) {
                    const [name, input, newValue] = f;
                    if (newValue === "" || input.value.trim() === newValue) return;
                    if (mode === "empty" && input.value.trim() !== "") return;
                    input.value = newValue;
                    filled.push(name);
                });

                if (isVerb && separableInput.checked !== entry.isSeparable && (mode === "all" || entry.isSeparable)) {
                    separableInput.checked = entry.isSeparable;
                    filled.push("Ayrılabilir");
                }

                // Tür kodla değiştiği için alanların görünürlüğü yenilenir
                pluralRow.classList.toggle("d-none", !/^\s*(der|die|das)\s/i.test(wordInput.value));
                updateVerbBox();

                Wiktionary.summary(entry, filled);
            });
        })();
    </script>
}