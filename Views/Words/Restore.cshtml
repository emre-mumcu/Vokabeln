<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Restore Backup</h4>
        </div>

        <div class="card-body">
            <div class="alert theme-danger">
                Geri yükleme, <strong>mevcut tüm verilerin üzerine yazar</strong>.
                İşlemden önce mevcut verinin otomatik bir kopyası uygulamanın <code>Backups</code> klasörüne kaydedilir.
            </div>

            <form asp-action="Restore" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="fg-danger mb-3"></div>

                <div class="mb-3">
                    <label for="file" class="form-label">Backup file (.db)</label>
                    <input type="file" id="file" name="file" class="form-control" accept=".db,.sqlite,.sqlite3" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="confirm" name="confirm" value="true" />
                    <label class="form-check-label" for="confirm">
                        Mevcut verilerin silineceğini anlıyorum
                    </label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary">Restore</button>
                </div>
            </form>
        </div>
    </div>
</div>