@* Veritabanını sıfırlama: "dbreset" yazılmadan Tamam butonu açılmaz (sunucu da ayrıca kontrol eder) *@
<div class="container mt-4">

    <section class="card">

        <div class="card-header">
            <h4 class="mb-0 fg-danger"><i class="bi bi-database-x"></i> Reset Database</h4>
        </div>

        <div class="card-body">

            <div class="alert theme-danger" role="alert">
                <p class="mb-2">
                    Veritabanındaki <strong>tüm veriler silinir</strong>: kelimeler, çekimler, oyunlar ve istatistikler.
                    Tablolar, indeksler, ID sayaçları ve migration geçmişi de silinip şema baştan oluşturulur; dosya küçültülür (VACUUM).
                </p>
                <p class="mb-0">
                    İşlemden önce mevcut verinin otomatik bir kopyası uygulamanın <code>Backups</code> klasörüne kaydedilir
                    (Restore ile geri yüklenebilir, Stats sayfasından silinebilir).
                </p>
            </div>

            <form asp-action="Reset" method="post" autocomplete="off">
                <div asp-validation-summary="All" class="fg-danger mb-3"></div>

                <div class="mb-3">
                    <label for="confirmText" class="form-label">Onaylamak için <code>dbreset</code> yazın</label>
                    <input type="text" id="confirmText" name="confirmText" class="form-control" spellcheck="false" autofocus />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn-outline theme-secondary">İptal</a>
                    <button type="submit" id="resetButton" class="btn-solid theme-danger" disabled>
                        <i class="bi bi-database-x"></i> Tamam
                    </button>
                </div>
            </form>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById("confirmText");
            const button = document.getElementById("resetButton");

            function update() {
                button.disabled = input.value.trim() !== "dbreset";
            }

            input.addEventListener("input", update);
            update();
        })();
    </script>
}
