@using Vokabeln.AppLib.Extensions
@model Vokabeln.AppData.Entities.WordEntity

@{
    // Geri: gelinen liste/arama sayfası; yoksa kelime listesi
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Index")!;

    // Düzenleme kaydedilince bu detay sayfasına geri dönülür
    var detailsUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";

    // Artikel rengi: der mavi, die kırmızı, das yeşil (Print ekranıyla aynı renk mantığı)
    var word = Model.Word.TrimStart();
    var articleClass = word.StartsWith("der ", StringComparison.OrdinalIgnoreCase) ? "fg-primary"
                     : word.StartsWith("die ", StringComparison.OrdinalIgnoreCase) ? "fg-danger"
                     : word.StartsWith("das ", StringComparison.OrdinalIgnoreCase) ? "fg-success"
                     : "fg-body";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="badge theme-secondary">@Model.WordType.GetDescription()</span>
            <span class="fg-secondary text-sm">#@Model.Id</span>
        </div>

        <div class="card-body">

            <h1 class="text-4xl fw-bold text-break mb-1 @articleClass">@Model.Word</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Plural))
            {
                <p class="text-lg fg-secondary mb-0">
                    <span class="text-sm text-uppercase">Çoğul</span> · @Model.Plural
                </p>
            }

            <hr />

            <h6 class="text-sm text-uppercase fg-secondary mb-1">Anlam</h6>
            @if (string.IsNullOrWhiteSpace(Model.Meaning))
            {
                <p class="fst-italic fg-secondary">Anlam girilmemiş.</p>
            }
            else
            {
                <p class="text-xl text-break">@Model.Meaning</p>
            }

            <h6 class="text-sm text-uppercase fg-secondary mb-1">Örnek</h6>
            @if (string.IsNullOrWhiteSpace(Model.Sample))
            {
                <p class="fst-italic fg-secondary mb-0">Örnek cümle girilmemiş.</p>
            }
            else
            {
                <p class="fst-italic text-lg text-break border-start ps-3 mb-0">@Model.Sample</p>
            }

        </div>

        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">

            <a href="@backUrl" class="btn btn-outline theme-secondary"><i class="bi bi-arrow-left"></i> Geri</a>

            <div class="d-flex gap-2">
                <a asp-action="Word" asp-route-id="@Model.Id" asp-route-returnUrl="@detailsUrl" class="btn btn-solid theme-primary">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @* Silinen kelimenin detay sayfası artık olmayacağı için listeye dönülür *@
                    <input type="hidden" name="returnUrl" value="@backUrl" />
                    <button type="submit" class="btn btn-solid theme-danger"
                            data-confirm="Bu kelimeyi silmek istediğinize emin misiniz?">
                        <i class="bi bi-trash3"></i> Delete
                    </button>
                </form>
            </div>

        </div>

    </div>

</div>
