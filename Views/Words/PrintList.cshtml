@using Vokabeln.AppData.Entities
@using Vokabeln.ViewModels
@model List<WordEntity>

@{
    var search = ViewData["Search"] as WordSearch;

    // Geri: yazdırmanın başlatıldığı liste/arama sayfası
    var returnUrl = ViewData["ReturnUrl"] as string;
    var backUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Index")!;
}

<div class="container mt-4">

    <div class="card shadow-sm mb-4 no-print">
        <div class="card-header"><h4 class="mb-0">Print List</h4></div>
        <div class="card-body">

            <p class="mb-3">
                @if (search is { IsActive: true })
                {
                    <i class="bi bi-search" aria-hidden="true"></i> @search.Describe()
                }
                else
                {
                    <text>Tüm kelimeler</text>
                }
                · <strong>@Model.Count</strong> kelime
            </p>

            <div class="d-flex justify-content-end gap-2">
                <a href="@backUrl" class="btn-outline theme-secondary"><i class="bi bi-arrow-left"></i> Geri</a>
                <button type="button" id="printButton" class="btn-solid theme-primary" disabled="@(Model.Count == 0)">
                    <i class="bi bi-printer"></i> Yazdır
                </button>
            </div>

        </div>
    </div>

    @if (Model.Count == 0)
    {
        <p class="no-print">Yazdırılacak kelime yok.</p>
    }
    else
    {
        <partial name="_PrintTable" model="Model" />
    }

</div>

@section Scripts {
    <script>
        (function () {
            const button = document.getElementById("printButton");
            button.addEventListener("click", function () { window.print(); });

            // Listeden "Yazdır" ile gelindiği için yazdırma penceresi sayfa yüklenince kendiliğinden açılır
            if (!button.disabled) {
                window.addEventListener("load", function () { window.print(); });
            }
        })();
    </script>
}
