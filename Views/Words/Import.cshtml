<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Import Words</h4>
        </div>

        <div class="card-body">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="fg-danger mb-3"></div>

                <div class="mb-3">
                    <label for="file" class="form-label">JSON File</label>
                    <input type="file" id="file" name="file" class="form-control" accept=".json,application/json" />
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Kayıt yöntemi</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="modeBulk" value="Bulk" checked />
                        <label class="form-check-label" for="modeBulk">
                            Toplu ekle <small class="fg-secondary">(hızlı; bir kelime hata verirse hiçbiri eklenmez)</small>
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="modeOneByOne" value="OneByOne" />
                        <label class="form-check-label" for="modeOneByOne">
                            Tek tek ekle <small class="fg-secondary">(yavaş; hatalı kelimeler ayrı listelenir, diğerleri eklenir)</small>
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-outline theme-secondary">Cancel</a>
                    <button type="submit" class="btn-solid theme-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>