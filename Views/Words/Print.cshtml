@using Vokabeln.AppData.Enums
@using Vokabeln.ViewModels
@model PrintViewModel

<div class="container mt-4">

    <div class="card shadow-sm mb-4 no-print">
        <div class="card-header"><h4 class="mb-0">Print Words</h4></div>
        <div class="card-body">
            <form asp-action="Print" method="get">

                <div class="mb-3">
                    <label asp-for="SelectedType" class="form-label">Kelime türü</label>
                    <select asp-for="SelectedType" id="typeSelect" class="form-control"
                            asp-items="Html.GetEnumSelectList<WordType>()">
                        <option value="">Tümü</option>
                    </select>
                </div>

                <div class="mb-3" id="articleBox" @(Model.SelectedType == WordType.Noun ? "" : "hidden")>
                    <label class="form-label d-block">Artikel</label>

                    <div class="form-check">
                        <input asp-for="Der" class="form-check-input" />
                        <label asp-for="Der" class="form-check-label">der</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Die" class="form-check-input" />
                        <label asp-for="Die" class="form-check-label">die</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Das" class="form-check-input" />
                        <label asp-for="Das" class="form-check-label">das</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn-outline theme-secondary">Listele</button>
                    <button type="button" class="btn-solid theme-primary" onclick="window.print()">Yazdır</button>
                </div>
            </form>
        </div>
    </div>

    <p class="no-print">@Model.Words.Count kelime listelendi.</p>

    @if (Model.Words.Count == 0)
    {
        <p class="no-print">Seçilen filtreye uygun kelime yok.</p>
    }
    else
    {
        <partial name="_PrintTable" model="Model.Words" />
    }
</div>

@section Scripts {
    <script>
        (function () {
            const select = document.getElementById("typeSelect");
            const box = document.getElementById("articleBox");
            const nounValue = "@((int)WordType.Noun)";

            select.addEventListener("change", function () {
                box.hidden = select.value !== nounValue;
            });
        })();
    </script>
}