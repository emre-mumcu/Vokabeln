@using Vokabeln.AppData.Enums
@using Vokabeln.ViewModels
@model PrintViewModel

<div class="container mt-4">

    <div class="card shadow-sm mb-4 no-print">
        <div class="card-header"><h4 class="mb-0">Print Words</h4></div>
        <div class="card-body">
            <form asp-action="Print" method="get">

                <div class="mb-3">
                    <label asp-for="SelectedType" class="form-label">Kelime türü</label>
                    <select asp-for="SelectedType" id="typeSelect" class="form-control"
                            asp-items="Html.GetEnumSelectList<WordType>()">
                        <option value="">Tümü</option>
                    </select>
                </div>

                <div class="mb-3" id="articleBox" @(Model.SelectedType == WordType.Noun ? "" : "hidden")>
                    <label class="form-label d-block">Artikel</label>

                    <div class="form-check">
                        <input asp-for="Der" class="form-check-input" />
                        <label asp-for="Der" class="form-check-label">der</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Die" class="form-check-input" />
                        <label asp-for="Die" class="form-check-label">die</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Das" class="form-check-input" />
                        <label asp-for="Das" class="form-check-label">das</label>
                    </div>
                </div>

                @* Yalnızca tür "Verb" iken: zaman seçilirse her fiil çekim tablosuyla basılır, seçilmezse eski düzen *@
                <div id="verbBox" @(Model.SelectedType == WordType.Verb ? "" : "hidden")>
                    <partial name="_TenseChecks" model="Model.Tenses" />

                    <div class="form-check mb-3">
                        <input asp-for="BlankForms" class="form-check-input" />
                        <label asp-for="BlankForms" class="form-check-label">
                            Çekimleri boş bırak <small class="fg-secondary">(alıştırma kağıdı: hücreler doldurulmak üzere boş basılır)</small>
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn-outline theme-secondary">Listele</button>
                    <button type="button" class="btn-solid theme-primary" onclick="window.print()">Yazdır</button>
                </div>
            </form>
        </div>
    </div>

    <p class="no-print">
        @Model.Words.Count kelime listelendi.
        @if (Model.IsConjugationLayout)
        {
            <span class="fg-secondary">Her fiil çekim tablosuyla basılır; tablolar sayfa arasında bölünmez.</span>
        }
    </p>

    @* Çekimi girilmemiş fiiller boş tablo olarak basılır; alıştırma kağıdında (boş bırak) uyarı gerekmez *@
    @if (Model.IsConjugationLayout && !Model.BlankForms && Model.MissingConjugationCount > 0)
    {
        <div class="alert theme-warning no-print">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>@Model.MissingConjugationCount</strong> / @Model.Words.Count fiilin seçilen zamanlardan en az birinde çekimi girilmemiş; bu hücreler boş basılır.
            <a asp-controller="Conjugations" asp-action="Bulk">Eksik çekimleri Wiktionary'den getir</a>
        </div>
    }

    @if (Model.Words.Count == 0)
    {
        <p class="no-print">Seçilen filtreye uygun kelime yok.</p>
    }
    else if (Model.IsConjugationLayout)
    {
        <partial name="_PrintConjugations" model="Model" />
    }
    else
    {
        <partial name="_PrintTable" model="Model.Words" />
    }
</div>

@section Scripts {
    <script>
        (function () {
            const select = document.getElementById("typeSelect");
            const articleBox = document.getElementById("articleBox");
            const verbBox = document.getElementById("verbBox");
            const nounValue = "@((int)WordType.Noun)";
            const verbValue = "@((int)WordType.Verb)";

            select.addEventListener("change", function () {
                articleBox.hidden = select.value !== nounValue;
                verbBox.hidden = select.value !== verbValue;
            });
        })();
    </script>
}
