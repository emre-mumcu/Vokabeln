@using Vokabeln.AppData.Entities
@using Vokabeln.ViewModels

@model PagedResult<WordEntity>

<div class="container p-5">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">Words</h3>
        
        <a asp-action="Word" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New</a>

    </div>

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kelime</th>
                            <th>Türü</th>
                            <th>Anlamı</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Kayıt bulunamadı.</td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Word</td>
                                <td>@item.WordType</td>
                                <td>@item.Meaning</td>
                                <td>
                                    <a asp-action="Word" asp-route-id="@item.Id" class="btn-text theme-accent"><i class="bi bi-pencil-square"></i> Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn-text theme-danger"
                                                data-confirm="Bu kelimeyi silmek istediğinize emin misiniz?">
                                            <i class="bi bi-trash3"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pager" model="Model" />

        </div>
    </div>

</div>