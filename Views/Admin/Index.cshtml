@using Vokabeln.ViewModels
@model List<GameStatsViewModel>

@{
    var hasStats = Model.Any(x => x.GameCount > 0 || x.AnswerCount > 0);
}

<div class="container mt-4">

    <div class="card shadow-sm mb-4">
        <div class="card-header"><h4 class="mb-0">Yönetim</h4></div>
        <div class="card-body">

            <h5>Oyun istatistikleri</h5>
            <p class="fg-secondary">
                Sıfırlama, üç oyunun da tüm oyun kayıtlarını ve verilen cevapları kalıcı olarak siler. Kelimeler etkilenmez.
            </p>

            <form asp-action="ResetGameStats" method="post">
                <button type="submit" class="btn-solid theme-danger"
                        data-confirm="Tüm oyun istatistikleri kalıcı olarak silinecek. Devam edilsin mi?"
                        disabled="@(!hasStats)">
                    <i class="bi bi-arrow-counterclockwise"></i> İstatistikleri sıfırla
                </button>
            </form>

        </div>
    </div>

    @foreach (var stats in Model)
    {
        <partial name="_GameStats" model="stats" />
    }

</div>
