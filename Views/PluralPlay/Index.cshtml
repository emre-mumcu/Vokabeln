@using Vokabeln.AppData.Enums
@using Vokabeln.ViewModels
@model PluralPlaySetupViewModel

@{
    var playable = ViewData["PlayableCount"] as int? ?? 0;
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header"><h4 class="mb-0">Plural Play</h4></div>
        <div class="card-body">

            <p class="fg-secondary">
                İsmin çoğulunu yaz: <span class="fg-primary fw-bold">der</span> Tisch → <span class="fg-danger fw-bold">die</span> Tische.
                Başına "die" yazmak zorunlu değil; büyük/küçük harf fark etmez.
                Yalnızca çoğulu girilmiş isimler sorulur (şu an <strong>@playable</strong> isim).
            </p>

            <form asp-action="Start" method="post">

                <div class="mb-3">
                    <label asp-for="QuestionCount" class="form-label">Soru sayısı</label>
                    <select asp-for="QuestionCount" class="form-control">
                        @foreach (var count in new[] { 5, 10, 20, 30, 50 })
                        {
                            <option value="@count">@count</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Tekil ismin artikeli</label>

                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var article in Enum.GetValues<ArticleFilter>())
                        {
                            <div class="form-check">
                                <input asp-for="Article" type="radio" value="@article" id="article@(article)" class="form-check-input" />
                                <label for="article@(article)" class="form-check-label">
                                    @(article == ArticleFilter.All ? "Tümü" : article.ToString().ToLowerInvariant())
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn-solid theme-primary" disabled="@(playable == 0)"><i class="bi bi-play-fill"></i> Başla</button>
                </div>
            </form>

        </div>
    </div>

</div>
