@using Vokabeln.AppLib.Extensions
@using Vokabeln.ViewModels
@model PluralQuestionViewModel

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Soru @Model.Number / @Model.Total</h4>
            <span class="fg-secondary">Puan: @Model.Score</span>
        </div>

        <div class="card-body text-center">

            <h2 class="text-4xl fw-bold mb-1 @Model.Word.Word.ArticleColorClass()">@Model.Word.Word</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Word.Meaning))
            {
                <p class="fg-secondary mb-4">@Model.Word.Meaning</p>
            }

            @if (!Model.Answered)
            {
                <form asp-action="Answer" method="post" class="text-start">
                    <partial name="_GameState" model="Model.State" />

                    <label for="plural" class="form-label">Çoğulu</label>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fg-danger fw-bold">die</span>
                        <input id="plural" name="plural" class="form-control" autocomplete="off" autocapitalize="off" spellcheck="false" autofocus />
                    </div>

                    <partial name="_UmlautKeys" />

                    @* Enter'a basınca DOM'daki ilk submit butonu çalışır: Kontrol et önce yazılır, flex-row-reverse ile solda Bitir görünür *@
                    <div class="d-flex flex-row-reverse gap-2">
                        <button type="submit" class="btn-solid theme-primary">Kontrol et</button>
                        <button type="submit" asp-action="Finish" class="btn-outline theme-secondary">Bitir</button>
                    </div>
                </form>
            }
            else
            {
                @if (Model.IsCorrect)
                {
                    <div class="alert theme-success">
                        <i class="bi bi-check-lg"></i> <strong>Doğru!</strong> @Model.Word.Plural
                    </div>
                }
                else
                {
                    <div class="alert theme-danger">
                        <i class="bi bi-x-lg"></i> <strong>Yanlış.</strong>
                        Senin cevabın <strong>@Model.Given</strong>, doğrusu <strong>@Model.Word.Plural</strong>.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Word.Sample))
                {
                    <p class="fst-italic fg-secondary mb-3">@Model.Word.Sample</p>
                }

                <form asp-action="Next" method="post">
                    <partial name="_GameState" model="@(new WordPlayState { GameId = Model.State.GameId, WordIds = Model.State.WordIds, Index = Model.State.Index + 1 })" />

                    <div class="d-flex justify-content-end gap-2">
                        @if (!Model.IsLast)
                        {
                            <button type="submit" asp-action="Finish" class="btn-outline theme-secondary">Bitir</button>
                        }
                        <button type="submit" class="btn-solid theme-primary" autofocus>
                            @(Model.IsLast ? "Sonucu gör" : "Sonraki soru")
                        </button>
                    </div>
                </form>
            }

        </div>

    </div>

</div>
