@using Vokabeln.AppLib.Extensions
@using Vokabeln.ViewModels
@model ConjugationPlaySetupViewModel

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header"><h4 class="mb-0">Konjugation Play</h4></div>
        <div class="card-body">

            <p class="fg-secondary">
                Seçilen zamanda fiilin çekimlerini yaz (ich, du, er/sie/es, wir, ihr, sie/Sie).
                Büyük/küçük harf ve fazla boşluk önemsizdir; başa zamir yazmak gerekmez.
                Birden fazla doğru form varsa birini yazman yeterli, istersen <code>/</code> ile ayırıp birkaçını yazabilirsin.
            </p>

            <form asp-action="Start" method="post">

                <div class="mb-3">
                    <label asp-for="QuestionCount" class="form-label">Soru (fiil) sayısı</label>
                    <select asp-for="QuestionCount" class="form-control">
                        @foreach (var count in new[] { 5, 10, 20, 30, 50 })
                        {
                            <option value="@count">@count</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Zaman</label>

                    @foreach (var option in Model.Tenses)
                    {
                        <div class="form-check">
                            <input asp-for="Tense" type="radio" value="@option.Tense" id="tense@(option.Tense)" class="form-check-input"
                                   disabled="@(option.VerbCount == 0)" />
                            <label for="tense@(option.Tense)" class="form-check-label">
                                @option.Tense.GetDescription()
                                <small class="fg-secondary">(@option.VerbCount fiil)</small>
                            </label>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn-solid theme-primary" disabled="@(Model.Tenses.All(x => x.VerbCount == 0))">
                        <i class="bi bi-play-fill"></i> Başla
                    </button>
                </div>
            </form>

        </div>
    </div>

</div>
