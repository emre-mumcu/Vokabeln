@using Vokabeln.ViewModels
@model WordPlayQuestionViewModel

@functions {
    string OptionClass(QuizOption option)
    {
        if (option.Id == Model.Word.Id) return "alert theme-success";
        if (option.Id == Model.SelectedOptionId) return "alert theme-danger";
        return "alert theme-secondary";
    }
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Soru @Model.Number / @Model.Total</h4>
            <span class="fg-secondary">Puan: @Model.Score</span>
        </div>

        <div class="card-body">

            <p class="fg-secondary mb-1">@Model.Word.WordType</p>
            <h2 class="mb-4">@Model.Word.Word</h2>

            @if (!Model.Answered)
            {
                <form asp-action="Answer" method="post">
                    <partial name="_State" model="Model.State" />
                    <input type="hidden" name="optionIds" value="@string.Join(",", Model.Options.Select(x => x.Id))" />

                    <div class="mb-4">
                        @foreach (var option in Model.Options)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="selectedId"
                                       id="option@(option.Id)" value="@option.Id" required />
                                <label class="form-check-label" for="option@(option.Id)">@option.Meaning</label>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        @* Aynı formu Finish'e gönderir; şık seçmek gerekmez *@
                        <button type="submit" asp-action="Finish" formnovalidate class="btn-outline theme-secondary">Bitir</button>
                        <button type="submit" class="btn-solid theme-primary">Cevapla</button>
                    </div>
                </form>
            }
            else
            {
                <div class="mb-3">
                    @foreach (var option in Model.Options)
                    {
                        <div class="@OptionClass(option) mb-2">
                            @if (option.Id == Model.Word.Id)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else if (option.Id == Model.SelectedOptionId)
                            {
                                <i class="bi bi-x-lg"></i>
                            }
                            @option.Meaning
                        </div>
                    }
                </div>

                <p class="mb-3"><strong>@(Model.IsCorrect ? "Doğru!" : "Yanlış.")</strong></p>

                @if (!string.IsNullOrWhiteSpace(Model.Word.Plural))
                {
                    <p class="mb-1"><span class="fg-secondary">Çoğul:</span> @Model.Word.Plural</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Word.Sample))
                {
                    <p class="mb-3"><span class="fg-secondary">Örnek:</span> @Model.Word.Sample</p>
                }

                <form asp-action="Next" method="post">
                    <partial name="_State" model="@(new WordPlayState { GameId = Model.State.GameId, WordIds = Model.State.WordIds, Index = Model.State.Index + 1 })" />

                    <div class="d-flex justify-content-end gap-2">
                        @if (!Model.IsLast)
                        {
                            <button type="submit" asp-action="Finish" class="btn-outline theme-secondary">Bitir</button>
                        }
                        <button type="submit" class="btn-solid theme-primary">
                            @(Model.IsLast ? "Sonucu gör" : "Sonraki soru")
                        </button>
                    </div>
                </form>
            }

        </div>

    </div>

</div>
